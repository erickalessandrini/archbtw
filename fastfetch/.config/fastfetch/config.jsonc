// fastfetch — Cyberpunk Neon
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": { "1": "#00ff9f", "2": "#00ff9f" },
    "padding": { "right": 2 }
  },
  "display": {
    "separator": " ╎ ",
    "color": { "keys": "#00b8ff", "separator": "#ea00d9", "output": "#d7fffe" },
    "percent": { "color": { "green": "#00ff9f", "yellow": "#f9f002", "red": "#ff2a6d" } }
  },
  "modules": [
    { "type": "os",       "key": " OS" },
    { "type": "kernel",   "key": " Kernel" },
    { "type": "wm",       "key": " WM" },
    { "type": "shell",    "key": " Shell" },
    { "type": "terminal", "key": " Term" },
    { "type": "cpu",      "key": " CPU" },
    { "type": "memory",   "key": " Memory" },
    { "type": "disk",     "key": "󰋊 Disk" },
    { "type": "battery",  "key": " Battery" },
    "break",
    { "type": "colors",   "symbol": "circle" }
  ]
}
