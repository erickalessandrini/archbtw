// waybar — Catppuccin Mocha, transparent top bar with pill groups
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,

  "modules-left": ["hyprland/workspaces", "wlr/taskbar", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["group/net", "group/hw", "battery", "tray"],

  "group/net": { "orientation": "horizontal", "modules": ["network", "pulseaudio"] },
  "group/hw":  { "orientation": "horizontal", "modules": ["cpu", "memory", "temperature"] },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": { "active": "", "default": "", "empty": "" },
    "persistent-workspaces": { "*": 5 },
    "on-click": "activate"
  },
  "hyprland/window": { "format": "{title}", "max-length": 50, "separate-outputs": true },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "maximize"
  },

  "clock": {
    "format": "  {:%H:%M}",
    "format-alt": "  {:%a %d %b %Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#00ff9f'><b>{}</b></span>",
        "weekdays": "<span color='#00b8ff'><b>{}</b></span>",
        "today": "<span color='#ff2a6d'><b><u>{}</u></b></span>"
      }
    }
  },

  "network": {
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "󰖪  offline",
    "tooltip-format": "{ifname}  {ipaddr}/{cidr}  via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",
    "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "cpu": { "format": "  {usage}%", "interval": 2 },
  "memory": { "format": "  {percentage}%", "interval": 5, "tooltip-format": "{used:0.1f} / {total:0.1f} GiB" },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "  {temperatureC}°C"
  },

  "battery": {
    "bat": "BAT0",
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"]
  },
  "tray": { "icon-size": 16, "spacing": 8 }
}
